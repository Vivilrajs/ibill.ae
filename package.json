{
  "name": "ibill",
  "version": "1.0.0",
  "private": true,
  "description": "ibill.ae - Vite frontend + NestJS API, deployed together on Vercel",
  "scripts": {
    "vercel-build": "cd backend && npm ci && npm run build && cd ../frontend && npm ci && npm run build",
    "dev:api": "cd backend && npm run start:dev",
    "dev:web": "cd frontend && npm run dev"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.1.6",
    "mongoose": "^9.9.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "~5.7.3"
  }
}
