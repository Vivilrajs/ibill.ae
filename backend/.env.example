# Copy to .env and fill in. `npm run start:dev` / `npm run seed` read .env then .env.local.

PORT=4000
# Comma-separated list of allowed browser origins (the frontend).
FRONTEND_ORIGIN=http://localhost:5173,https://ibill.ae

# MongoDB Atlas - the store for all content and leads.
# Whitelist this server's IP in Atlas > Network Access.
MONGODB_URI=
MONGODB_DB=ibill

# Admin login (Bearer token = HMAC of email+password over AUTH_SECRET).
# Changing ADMIN_PASSWORD or AUTH_SECRET invalidates every issued token.
ADMIN_EMAIL=admin@ibill.ae
ADMIN_PASSWORD=change-me
AUTH_SECRET=generate-a-long-random-string

# Public site URL - used in contact notification emails.
SITE_URL=https://ibill.ae

# Contact form notifications (optional). Without RESEND_API_KEY the notification
# is only logged; the lead is still stored in MongoDB.
CONTACT_NOTIFY_EMAIL=info@ibill.ae
RESEND_API_KEY=
CONTACT_FROM_EMAIL=IBILL Website <onboarding@resend.dev>
